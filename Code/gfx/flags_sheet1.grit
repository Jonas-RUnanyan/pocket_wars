# Symbol name
-s flags_sheet1

# Set the warning/log level to 3
-W3

# Set the transparent color to FF00FF (magenta padding/background)
-gTFF00FF

# Tile graphics, not bitmap — needed to extract individual flag cells
-gt

# Set the bit depth to 8 (256-color, shared palette across the sheet)
-gB8

# Share one palette across the whole sheet
-pS